# Copy this file to apps/api/.env (see README)
DATABASE_URL="file:./dev.db"
JWT_SECRET=""
PORT=3001
# Keep false when clients connect directly. Set to the exact trusted proxy-hop
# count (for example 1) only when the API is deployed behind that proxy.
TRUST_PROXY=false

# OpenRouter (server-side only)
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY=""
AI_MODEL="openai/gpt-4o-mini"
